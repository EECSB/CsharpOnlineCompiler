            jsInterop = new JSInterop(JSR, this);

            await initGun();
            await jsInterop.SendObjectReference();
            await jsInterop.InitializeMonaco(state.EditorText, "csharp");

            if (loadPrivateFromURL)
            {
                loadPrivateFromURL = false;
