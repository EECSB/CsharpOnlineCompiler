    private async Task reloadPackages(bool isFirstLoad = false)
    {
        if (prevState is null)
        {
            loadingNugetPackages = false;
            return;
        }

        loadingNugetPackages = true;

        //Get list of added packages and install them.
        List<string> addedPackages;
        if (isFirstLoad)
            addedPackages = state.AddedNugetPackages.Keys.ToList();
        else
            addedPackages = state.AddedNugetPackages.Keys.Except(prevState?.AddedNugetPackages.Keys ?? Enumerable.Empty<string>()).ToList();

        foreach (var package in addedPackages)
        {
            loadingNugetPackages = true;

            await selectNugetPackage(package);

            PackageVersion packageVersion = null;
            IEnumerable<PackageVersion> versions = selectedPackage.Versions.Where(x => x.Version == state.AddedNugetPackages[package].PackageVersion);
            if (versions.Count() > 0)
            {
                packageVersion = versions.First();
                await installNugetPackage(packageVersion);
            }
            else
            {
                //Let user know there are no compatible versions?
                //But this should never happen as incompatible nuget packages can't be added in the first place.
            }
        }

        //On first load there is not going to be any packages to remove.
        if (isFirstLoad)
        {
            loadingNugetPackages = false;    
            return;
        }

        //Get list of removed packages.
        List<string> removedPackages = prevState?.AddedNugetPackages.Keys.Except(state.AddedNugetPackages.Keys).ToList() ?? new List<string>();

        foreach (var package in removedPackages)
        {
            loadingNugetPackages = true;

            removeNugetPackage(package);
        }

        loadingNugetPackages = false;
    }

    private async Task queryNugetPackage(string nugetPackageName)
    {
        //Clear selection
        selectedPackage = null;
        selectedPackageVersion = null;
        versions = Array.Empty<PackageVersion>();

        //Get autocomplete package suggestions.
        suggestions = await nugetLoader.QueryAutoComplete(nugetPackageName);
        //Filter out already installed packages.
        suggestions = suggestions.Where(x => !state.AddedNugetPackages.ContainsKey(x));

        StateHasChanged();
    }

    private async Task selectNugetPackage(string selectedNugetPackageName)
    {
        var packageData = await nugetLoader.QueryPackageDetails(selectedNugetPackageName);

        selectedPackage = packageData;

        versions = packageData.Versions;

        //Clear selection
        suggestions = Array.Empty<string>();
        nugetQueryTextBox = "";

        StateHasChanged();
    }

    private async Task installNugetPackage(PackageVersion packageVersion)
    {
        selectedPackageVersion = packageVersion;

        await compiler.InitializationTask; //Make sure ExistingReferences is filled before using it.

        IEnumerable<(string name, Stream stream)> packageAndDependencies = null;
        try
        {
            packageAndDependencies = await nugetLoader.GetPackageAndDependencies(packageVersion.Id, compiler.ExistingReferences);

            if (packageAndDependencies?.Count() > 0)
            {
                compiler.AddLateReference(packageAndDependencies);
                state.AddNugetPackage(selectedPackage.PackageId, packageVersion.Version);
            }
            else
            {
                await JSR.InvokeVoidAsync("alert", "Failed to install package. Please try again. Package not found, bad connection, unsupported TFM(target Framework Moniker) or other error.");

                selectedPackage = null;
                selectedPackageVersion = null;
                versions = Array.Empty<PackageVersion>();
            }

            //Clear selection
            versions = Array.Empty<PackageVersion>();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSR.InvokeVoidAsync("alert", $"Failed to install package. {ex.Message}");
        }
    }

    private void removeNugetPackage(string packageName)
    {
        state.RemoveNugetPackage(packageName);

        //TODO: Remove package from compiler references. The dependencies for the package should also be removed(unless needed by another package).
        //The code should probably be changed so that we store the name+versions of all the dependencies that were added for a certain package.
    }

