                ms.Write(text, 0, text.Length);
                //Rewind the stream to the beginning.
                ms.Seek(0, SeekOrigin.Begin);

                asm = loadContext.LoadFromStream(ms);
            }
            */


            //Get the entry point and invoke it.
            var entry = asm.EntryPoint;
            if (entry.Name == "<Main>") //Sync wrapper over async Task Main
                entry = entry.DeclaringType.GetMethod("Main", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static); // reflect for the async Task Main

            var hasArgs = entry.GetParameters().Length > 0;
            var result = entry.Invoke(null, hasArgs ? new object[] { new string[0] } : null);

            //If the entry point is an async method, wait for it to finish.
            if (result is Task t)
            {
                await t;

                if (t.IsFaulted)
                {
                    //Get exception info.
                    Exception ex = t.Exception;
                    Exception innerEx = ex.InnerException;

                    //Create error message.
                    outputs.Add($"Execution error message: {innerEx.Message} StackTrace:{innerEx.StackTrace}");
                }
            }

            string output = writer.ToString();
            outputs.Add(output);
        }
        catch (Exception ex)
        {
            string errString = ex.ToString();
            outputs.Add("Application Error: " + errString);
        }
    }

    class PluginLoadContext : AssemblyLoadContext
    {
        private Dictionary<string, byte[]> dynamicallyAddedDLLs;
        private Dictionary<string, byte[]> referencesDLLs;

        public PluginLoadContext(Dictionary<string, byte[]> DynamicallyAddedDLLs, Dictionary<string, byte[]> ReferencesDLLs)
        {
            dynamicallyAddedDLLs = DynamicallyAddedDLLs;
            referencesDLLs = ReferencesDLLs;
        }

        protected override Assembly Load(AssemblyName assemblyName)
        {
            if (dynamicallyAddedDLLs != null && dynamicallyAddedDLLs.Count > 0)
            {
                //
                byte[] dll;
                if (dynamicallyAddedDLLs.ContainsKey(assemblyName.Name))
                    dll = dynamicallyAddedDLLs[assemblyName.Name];
                else 
                    dll = referencesDLLs[assemblyName.Name + ".dll"];

                return Assembly.Load(dll);
            }

            return null;
        }

        protected override IntPtr LoadUnmanagedDll(string unmanagedDllName)
        {
            /*if (libraryPath != null)
                {
                return LoadUnmanagedDllFromPath(libraryPath);
            }*/

            return IntPtr.Zero;
        }
    }

    [Obsolete("Use ALC instead.")]
    private Assembly ResolveAssembliesForCurrentDomain(object sender, ResolveEventArgs args) 
    {
        string assemblyName = new AssemblyName(args.Name).Name;

        if (compiler.DynamicallyAddedDLLs.ContainsKey(assemblyName))
        {
            Console.WriteLine(assemblyName);
            return Assembly.Load(compiler.DynamicallyAddedDLLs[assemblyName]);
        }

        return null;
    }

